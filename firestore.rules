rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // ─────────────────────────────────────────────────────────────
    // HELPER FUNCTIONS
    // ─────────────────────────────────────────────────────────────
    
    // Check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Check if user is admin
    function isAdmin() {
      return isAuthenticated() && request.auth.token.admin == true;
    }
    
    // Check if user owns the document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // ─────────────────────────────────────────────────────────────
    // USER COLLECTION
    // ─────────────────────────────────────────────────────────────
    
    match /users/{userId} {
      // Users can read their own document, admins can read all
      allow read: if isOwner(userId) || isAdmin();
      
      // Users can create their own document
      allow create: if isOwner(userId);
      
      // Users can update their own document (limited fields), admins can update any
      allow update: if isOwner(userId) || isAdmin();
      
      // Only admins can delete user documents
      allow delete: if isAdmin();
    }
    
    // ─────────────────────────────────────────────────────────────
    // LEVELS COLLECTION (gamification tiers)
    // ─────────────────────────────────────────────────────────────
    
    match /levels/{levelId} {
      // Anyone authenticated can read levels (needed for profile display)
      allow read: if isAuthenticated();
      
      // Only admins can manage levels
      allow create, update, delete: if isAdmin();
    }
    
    // ─────────────────────────────────────────────────────────────
    // POINT ACTIVITIES (gamification point values per action)
    // ─────────────────────────────────────────────────────────────
    
    match /pointActivities/{activityKey} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }
    
    // ─────────────────────────────────────────────────────────────
    // GAMERTAGS COLLECTION (unique display name lookup)
    // ─────────────────────────────────────────────────────────────
    
    match /gamertags/{tag} {
      // Anyone can check gamertag availability
      allow read: if true;
      
      // All writes go through Admin SDK on the server
      allow create, update, delete: if false;
    }
    
    // ─────────────────────────────────────────────────────────────
    // CONTENT COLLECTION (Shows, Stories, Cards, Games)
    // ─────────────────────────────────────────────────────────────
    
    match /content/{contentId} {
      // Anyone can read published content, admins can read all
      allow read: if resource.data.isPublished == true || isAdmin();
      
      // Only admins can create content
      allow create: if isAdmin();
      
      // Only admins can update content
      allow update: if isAdmin();
      
      // Only admins can delete content
      allow delete: if isAdmin();
    }

    // Shared metadata per game engine route (e.g. engine theme music URL for all skins)
    match /gameEngines/{engineSlug} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
    
    // ─────────────────────────────────────────────────────────────
    // EXPERIENCES COLLECTION (Home page rows)
    // ─────────────────────────────────────────────────────────────
    
    match /experiences/{experienceId} {
      // Anyone can read published experiences, admins can read all
      allow read: if resource.data.isPublished == true || isAdmin();

      // Only admins can create experiences
      allow create: if isAdmin();

      // Only admins can update experiences
      allow update: if isAdmin();

      // Only admins can delete experiences
      allow delete: if isAdmin();
    }

    // ─────────────────────────────────────────────────────────────
    // PAGES COLLECTION (standalone slug-addressed pages)
    // ─────────────────────────────────────────────────────────────

    match /pages/{pageId} {
      // Anyone can read published pages, admins can read all
      allow read: if resource.data.isPublished == true || isAdmin();
      // Only admins can author pages
      allow create, update, delete: if isAdmin();
    }

    // ─────────────────────────────────────────────────────────────
    // FEATURED CAROUSELS (named feature banners; items live in /featured)
    // ─────────────────────────────────────────────────────────────

    match /featuredCarousels/{carouselId} {
      // Managed in admin; page rendering reads featured items server-side.
      allow read: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // ─────────────────────────────────────────────────────────────
    // ROW COLLECTIONS (named bundles of rows; rows live in /experiences)
    // ─────────────────────────────────────────────────────────────

    match /rowCollections/{collectionId} {
      // Managed in admin; page rendering reads experiences server-side.
      allow read: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // ─────────────────────────────────────────────────────────────
    // GRID COLLECTIONS (named grids of content; shown as page segments)
    // ─────────────────────────────────────────────────────────────

    match /gridCollections/{gridId} {
      // Managed in admin; page rendering resolves grid content server-side.
      allow read: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // ─────────────────────────────────────────────────────────────
    // BUTTON STYLES (named, reusable CTA pill gradients)
    // ─────────────────────────────────────────────────────────────

    match /buttonStyles/{styleId} {
      // Managed in admin; CTA pills are resolved server-side at render time.
      allow read: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // ─────────────────────────────────────────────────────────────
    // BRANDS COLLECTION
    // ─────────────────────────────────────────────────────────────
    
    match /brands/{brandId} {
      // Anyone can read published brands, admins can read all
      allow read: if resource.data.isPublished == true || isAdmin();
      
      // Only admins can create brands
      allow create: if isAdmin();
      
      // Only admins can update brands
      allow update: if isAdmin();
      
      // Only admins can delete brands
      allow delete: if isAdmin();
    }
    
    // ─────────────────────────────────────────────────────────────
    // ALERTS COLLECTION
    // ─────────────────────────────────────────────────────────────
    
    match /alerts/{alertId} {
      // Anyone can read published alerts, admins can read all
      allow read: if resource.data.isPublished == true || isAdmin();
      
      // Only admins can create alerts
      allow create: if isAdmin();
      
      // Only admins can update alerts
      allow update: if isAdmin();
      
      // Only admins can delete alerts
      allow delete: if isAdmin();
    }
    
    // ─────────────────────────────────────────────────────────────
    // FEATURED COLLECTION
    // ─────────────────────────────────────────────────────────────
    
    match /featured/{featuredId} {
      // Anyone can read active featured items, admins can read all
      allow read: if resource.data.isActive == true || isAdmin();
      
      // Only admins can create featured items
      allow create: if isAdmin();
      
      // Only admins can update featured items
      allow update: if isAdmin();
      
      // Only admins can delete featured items
      allow delete: if isAdmin();
    }
    
    // ─────────────────────────────────────────────────────────────
    // AI ARTISTS COLLECTION
    // ─────────────────────────────────────────────────────────────
    
    match /artists/{artistId} {
      // Anyone can read published artists, admins can read all
      allow read: if resource.data.isPublished == true || isAdmin();
      
      // Only admins can create artists
      allow create: if isAdmin();
      
      // Only admins can update artists
      allow update: if isAdmin();
      
      // Only admins can delete artists
      allow delete: if isAdmin();
    }
    
    // ─────────────────────────────────────────────────────────────
    // ALBUMS COLLECTION
    // ─────────────────────────────────────────────────────────────
    
    match /albums/{albumId} {
      // Anyone can read published albums, admins can read all
      allow read: if resource.data.isPublished == true || isAdmin();
      
      // Only admins can create albums
      allow create: if isAdmin();
      
      // Only admins can update albums
      allow update: if isAdmin();
      
      // Only admins can delete albums
      allow delete: if isAdmin();
    }
    
    // ─────────────────────────────────────────────────────────────
    // SONGS COLLECTION
    // ─────────────────────────────────────────────────────────────
    
    match /songs/{songId} {
      // Anyone can read published songs, admins can read all
      allow read: if resource.data.isPublished == true || isAdmin();
      
      // Only admins can create songs
      allow create: if isAdmin();
      
      // Only admins can update songs
      allow update: if isAdmin();
      
      // Only admins can delete songs
      allow delete: if isAdmin();
    }
    
    // ─────────────────────────────────────────────────────────────
    // MUSIC VIDEOS COLLECTION
    // ─────────────────────────────────────────────────────────────
    
    match /musicVideos/{videoId} {
      // Anyone can read published music videos, admins can read all
      allow read: if resource.data.isPublished == true || isAdmin();
      
      // Only admins can create music videos
      allow create: if isAdmin();
      
      // Only admins can update music videos
      allow update: if isAdmin();
      
      // Only admins can delete music videos
      allow delete: if isAdmin();
    }
    
    // ─────────────────────────────────────────────────────────────
    // AVATARS COLLECTION (Lottie avatar metadata)
    // ─────────────────────────────────────────────────────────────
    
    match /avatars/{avatarId} {
      // Anyone can read avatars (they're public assets)
      allow read: if true;
      
      // Only admins can manage avatars
      allow create, update, delete: if isAdmin();
    }
    
    // ─────────────────────────────────────────────────────────────
    // AUCTION (Fine Art Auctions)
    // ─────────────────────────────────────────────────────────────
    
    match /auctions/{auctionId} {
      // Authenticated users can read auctions
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }
    
    match /auction_items/{itemId} {
      // Authenticated users can read auction items when auction is active (filtered client-side)
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
      
      // Bids subcollection - writes via API (Admin SDK), admins can read bid history
      match /bids/{bidId} {
        allow read: if isAdmin();
        allow create, update, delete: if false;  // Only via API
      }
    }
    
    // ─────────────────────────────────────────────────────────────
    // STORIES COLLECTION (Reading Experience)
    // ─────────────────────────────────────────────────────────────
    
    match /stories/{storyId} {
      allow read: if resource.data.isPublished == true || isAdmin();
      allow create, update, delete: if isAdmin();
    }
    
    // ─────────────────────────────────────────────────────────────
    // USER STORY SETTINGS & READING PROGRESS
    // ─────────────────────────────────────────────────────────────
    
    match /users/{userId}/story-settings/{doc} {
      allow read, write: if isOwner(userId);
    }
    
    match /users/{userId}/reading-progress/{doc} {
      allow read, write: if isOwner(userId);
    }
    
    // ─────────────────────────────────────────────────────────────
    // AI PERSONAS (Game AI characters with stats)
    // ─────────────────────────────────────────────────────────────
    
    match /aiPersonas/{personaId} {
      // Anyone authenticated can read active personas (needed for game lobbies)
      allow read: if isAuthenticated();
      
      // Only admins can create/delete personas
      allow create, delete: if isAdmin();
      
      // Only admins (and Admin SDK callable functions) can update personas
      allow update: if isAdmin();
    }
    
    // ─────────────────────────────────────────────────────────────
    // GAME SESSIONS (Multiplayer lobbies)
    // ─────────────────────────────────────────────────────────────
    
    match /gameSessions/{sessionId} {
      // Uids present before the update but not after (who this write removes).
      function rosterRemovals() {
        return resource.data.get('playerUids', [])
          .removeAll(request.resource.data.get('playerUids', []));
      }
      // Non-host roster ops may remove at most ONE uid: themselves (leave) or
      // an AI seat (join-evict). Removing another human is host/server-only.
      function removesOnlySelfOrOneAI() {
        return rosterRemovals().size() == 0
          || (rosterRemovals().size() == 1
              && (rosterRemovals()[0] == request.auth.uid
                  || rosterRemovals()[0].matches('ai-.*')));
      }

      allow read: if isAuthenticated();
      allow create: if isAuthenticated();

      // Two regimes, switched by whether the session has a `resolverKey`:
      //
      // LEGACY / client-resolved (no resolverKey): host (ownerId) can write any
      //   field; non-host players can only modify the whitelisted action/join
      //   fields. Unchanged behavior.
      //
      // SERVER-AUTHORITATIVE (resolverKey set): the gameEngine Cloud Function
      //   (Admin SDK, bypasses rules) owns all round progression. Participants
      //   may write only their own pendingMoves slot + roster fields (allowlist
      //   below); the host may also drive AI slots / comments and reset to the
      //   start-of-game shape (startGame / Play Again).
      allow update: if isAuthenticated() && (
        // ENGINE (engineKey set): the generic gameEngine Cloud Function owns ALL
        // game state. Clients write only lobby roster; every game event goes
        // through the authenticated API route (Admin SDK, bypasses rules). The
        // host may start / reset to the value-checked start-of-game shape.
        ( ('engineKey' in resource.data) && (
          ( ( request.auth.uid in request.resource.data.playerUids
              || request.auth.uid in resource.data.playerUids )
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'playerUids', 'players', 'playerCount', 'pendingInviteUids',
              'kickedUids', 'updatedAt'
            ])
            // Host manages the roster freely (kick / add-AI); everyone else
            // may only join, leave, or replace one AI seat — and may not
            // touch kickedUids (kicking is a host power).
            && ( resource.data.ownerId == request.auth.uid
                 || ( removesOnlySelfOrOneAI()
                      && !request.resource.data.diff(resource.data)
                           .affectedKeys().hasAny(['kickedUids']) ) ) )
          ||
          ( resource.data.ownerId == request.auth.uid
            && request.resource.data.engineKey == resource.data.engineKey
            && request.resource.data.status == 'playing'
            && request.resource.data.currentRound == 0
            && request.resource.data.rounds.size() == 0
            && request.resource.data.winner == null
            // seq == 0 is unique to the reset shape: the engine bumps seq on
            // every advance, so this blocks a host from writing game fields
            // mid-game (when seq > 0) while still permitting Play Again.
            && request.resource.data.seq == 0 )
          ||
          // Pre-game lobby setup: the host may freely configure the lobby
          // (pack pick, round count, etc.) while status is still 'lobby'. No
          // game state exists yet — the engine only runs once status=='playing'
          // — and startGame itself (lobby → playing) is allowed here too.
          ( resource.data.ownerId == request.auth.uid
            && resource.data.status == 'lobby'
            && request.resource.data.engineKey == resource.data.engineKey )
        ) )
        ||
        ( !('engineKey' in resource.data) && (
          ( !('resolverKey' in resource.data) && (
            resource.data.ownerId == request.auth.uid
            || (request.auth.uid in request.resource.data.playerUids
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'pendingTap', 'currentClue', 'guessesRemaining',
                'guessesUsedThisTurn', 'bonusGuessAvailable',
                'activeTeam', 'svPhase', 'updatedAt',
                'playerUids', 'players', 'playerCount',
                'pendingInviteUids',
                // Sweep the Leg / Tap Smash Arena — simultaneous-move submissions
                'pendingMoves',
                // Bluff Box — the current "sharer" rotates each round and is
                // often not the host. They write the revealed card + remaining
                // pool, their share text, their truth/lie pick, and advance the
                // phase. Every other player writes their own vote nested under
                // guesses.{uid}.
                'sharerChoice', 'guesses', 'bbPhase',
                'cardURL', 'cardPool', 'humanShareText',
                // Mega Sketchy — the player whose turn it is appends their
                // drawing/guess to chains.{elementIndex}; any player casts a
                // vote nested under votes.{uid}. (Phase advance, play order,
                // element-match + scoring judgements are all host-only writes.)
                'chains', 'votes',
                // Boaty McBoatface — legacy (pre-engine) sessions only; new
                // Boaty sessions use the engineKey regime above.
                'btBoards', 'btReady', 'btAttacks', 'btLastAttack',
                'btCurrentTurn', 'btWinner', 'btPhase'
              ]))
          ) )
          ||
          ( ('resolverKey' in resource.data) && (
            // (1) Participants may write ONLY: their own pendingMoves slot
            //     (the host may also write AI slots — solo-vs-AI mode), the
            //     host-authored AI post-game comments, and lobby roster ops
            //     (join / add-AI / kick). Everything else — including other
            //     players' moves — is server-owned. (Previously a denylist,
            //     which let any participant forge opponents' pendingMoves.)
            ( request.auth.uid in request.resource.data.playerUids
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'pendingMoves', 'aiPostGameComments',
                'playerUids', 'players', 'playerCount',
                'pendingInviteUids', 'kickedUids', 'updatedAt'
              ])
              // pendingMoves: non-hosts may only touch their own slot. The
              // host may write other slots (it drives the AI's move in solo
              // mode) — host-trust matches the legacy model for these games.
              && ( resource.data.ownerId == request.auth.uid
                   || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['pendingMoves'])
                   || request.resource.data.get('pendingMoves', {})
                        .diff(resource.data.get('pendingMoves', {}))
                        .affectedKeys().hasOnly([request.auth.uid]) )
              // AI post-game comments are host-authored.
              && ( resource.data.ownerId == request.auth.uid
                   || !request.resource.data.diff(resource.data).affectedKeys().hasAny(['aiPostGameComments']) ) )
            ||
            // (2) Host reset to the start-of-game shape (startGame / Play Again).
            //     Value-checked, so it may also set seq / replayCount / other
            //     fields, but can never forge a round result or a win.
            ( resource.data.ownerId == request.auth.uid
              && request.resource.data.resolverKey == resource.data.resolverKey
              && request.resource.data.status == 'playing'
              && request.resource.data.currentRound == 0
              && request.resource.data.rounds.size() == 0
              && request.resource.data.winner == null )
          ) )
        ) )
      );

      allow delete: if isAdmin();
    }
    
    // ─────────────────────────────────────────────────────────────
    // INVITE CODES (Multiplayer game join codes)
    // ─────────────────────────────────────────────────────────────
    
    match /inviteCodes/{code} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }
    
    // ─────────────────────────────────────────────────────────────
    // MEGA SKETCHY MISSIONS (Custom game missions)
    // ─────────────────────────────────────────────────────────────
    
    match /megasketchyMissions/{missionId} {
      // Anyone authenticated can read official & shared missions,
      // creators can read their own private missions, admins read all
      allow read: if isAdmin()
        || resource.data.visibility == "official"
        || resource.data.visibility == "shared"
        || (isAuthenticated() && resource.data.creatorId == request.auth.uid);
      
      // Authenticated users can create missions (pro/admin gating is client-side).
      // creatorId must match the requesting user.
      // Only admins can create "official" missions.
      allow create: if isAuthenticated()
        && request.resource.data.creatorId == request.auth.uid
        && (request.resource.data.visibility != "official" || isAdmin());
      
      // Creator can update their own missions, admins can update any.
      // Only admins can set visibility to "official".
      allow update: if (isAuthenticated() && resource.data.creatorId == request.auth.uid || isAdmin())
        && (request.resource.data.visibility != "official" || isAdmin());
      
      // Creator can delete their own missions, admins can delete any
      allow delete: if (isAuthenticated() && resource.data.creatorId == request.auth.uid) || isAdmin();
    }
    
    // ─────────────────────────────────────────────────────────────
    // BLUFF BOX PACKS (Card packs for Bluff Box game)
    // ─────────────────────────────────────────────────────────────
    
    match /bluffboxPacks/{packId} {
      // Anyone authenticated can read official & shared packs,
      // creators can read their own private packs, admins read all
      allow read: if isAdmin()
        || resource.data.visibility == "official"
        || resource.data.visibility == "shared"
        || (isAuthenticated() && resource.data.creatorId == request.auth.uid);
      
      // Authenticated users can create packs (pro/admin gating is client-side).
      // creatorId must match the requesting user.
      // Only admins can create "official" packs.
      allow create: if isAuthenticated()
        && request.resource.data.creatorId == request.auth.uid
        && (request.resource.data.visibility != "official" || isAdmin());
      
      // Creator can update their own packs, admins can update any.
      // Only admins can set visibility to "official".
      allow update: if (isAuthenticated() && resource.data.creatorId == request.auth.uid || isAdmin())
        && (request.resource.data.visibility != "official" || isAdmin());
      
      // Creator can delete their own packs, admins can delete any
      allow delete: if (isAuthenticated() && resource.data.creatorId == request.auth.uid) || isAdmin();
    }
    
    // ─────────────────────────────────────────────────────────────
    // GAME INVITES (Direct player invitations)
    // ─────────────────────────────────────────────────────────────
    
    match /gameInvites/{inviteId} {
      // Recipients can read their own invites, senders can read theirs
      allow read: if isAuthenticated()
        && (resource.data.toUid == request.auth.uid
         || resource.data.fromUid == request.auth.uid);
      
      // Authenticated users can create invites (must be the sender)
      allow create: if isAuthenticated()
        && request.resource.data.fromUid == request.auth.uid;
      
      // Sender or recipient can delete an invite
      allow delete: if isAuthenticated()
        && (resource.data.fromUid == request.auth.uid
         || resource.data.toUid == request.auth.uid);
      
      // No updates needed — invites are created then deleted
      allow update: if false;
    }
    
    // ─────────────────────────────────────────────────────────────
    // FYVE HEISTS (Heist packs for FYVE game)
    // ─────────────────────────────────────────────────────────────

    match /fyveHeists/{heistId} {
      // Anyone authenticated can read official & shared heists,
      // creators can read their own private heists, admins read all
      allow read: if isAdmin()
        || resource.data.visibility == "official"
        || resource.data.visibility == "shared"
        || (isAuthenticated() && resource.data.creatorId == request.auth.uid);

      // Authenticated users can create heists (pro/admin gating is client-side).
      // creatorId must match the requesting user.
      // Only admins can create "official" heists.
      allow create: if isAuthenticated()
        && request.resource.data.creatorId == request.auth.uid
        && (request.resource.data.visibility != "official" || isAdmin());

      // Creator can update their own heists, admins can update any.
      // Only admins can set visibility to "official".
      allow update: if (isAuthenticated() && resource.data.creatorId == request.auth.uid || isAdmin())
        && (request.resource.data.visibility != "official" || isAdmin());

      // Creator can delete their own heists, admins can delete any
      allow delete: if (isAuthenticated() && resource.data.creatorId == request.auth.uid) || isAdmin();
    }

    // ─────────────────────────────────────────────────────────────
    // FYVE BOMBS (Reusable bomb designs for FYVE game)
    // ─────────────────────────────────────────────────────────────

    match /fyveBombs/{bombId} {
      // Anyone authenticated can read official & shared bombs,
      // creators can read their own private bombs, admins read all
      allow read: if isAdmin()
        || resource.data.visibility == "official"
        || resource.data.visibility == "shared"
        || (isAuthenticated() && resource.data.creatorId == request.auth.uid);

      // Authenticated users can create bombs (pro/admin gating is client-side).
      // creatorId must match the requesting user.
      // Only admins can create "official" bombs.
      allow create: if isAuthenticated()
        && request.resource.data.creatorId == request.auth.uid
        && (request.resource.data.visibility != "official" || isAdmin());

      // Creator can update their own bombs, admins can update any.
      // Only admins can set visibility to "official".
      allow update: if (isAuthenticated() && resource.data.creatorId == request.auth.uid || isAdmin())
        && (request.resource.data.visibility != "official" || isAdmin());

      // Creator can delete their own bombs, admins can delete any
      allow delete: if (isAuthenticated() && resource.data.creatorId == request.auth.uid) || isAdmin();
    }

    // ─────────────────────────────────────────────────────────────
    // WORDONKULOUS PACKS (Definition packs for Wordonkulous game)
    // ─────────────────────────────────────────────────────────────

    match /wordonkulousPacks/{packId} {
      // Anyone authenticated can read official & shared packs,
      // creators can read their own private packs, admins read all
      allow read: if isAdmin()
        || resource.data.visibility == "official"
        || resource.data.visibility == "shared"
        || (isAuthenticated() && resource.data.creatorId == request.auth.uid);

      // Authenticated users can create packs (pro/admin gating is client-side).
      // creatorId must match the requesting user.
      // Only admins can create "official" packs.
      allow create: if isAuthenticated()
        && request.resource.data.creatorId == request.auth.uid
        && (request.resource.data.visibility != "official" || isAdmin());

      // Creator can update their own packs, admins can update any.
      // Only admins can set visibility to "official".
      allow update: if (isAuthenticated() && resource.data.creatorId == request.auth.uid || isAdmin())
        && (request.resource.data.visibility != "official" || isAdmin());

      // Creator can delete their own packs, admins can delete any
      allow delete: if (isAuthenticated() && resource.data.creatorId == request.auth.uid) || isAdmin();
    }

    // ─────────────────────────────────────────────────────────────
    // BLARF PACKS (Word packs for BLARF game)
    // ─────────────────────────────────────────────────────────────

    match /blarfPacks/{packId} {
      // Anyone authenticated can read official & shared packs,
      // creators can read their own private packs, admins read all
      allow read: if isAdmin()
        || resource.data.visibility == "official"
        || resource.data.visibility == "shared"
        || (isAuthenticated() && resource.data.creatorId == request.auth.uid);

      // Authenticated users can create packs (pro/admin gating is client-side).
      // creatorId must match the requesting user.
      // Only admins can create "official" packs.
      allow create: if isAuthenticated()
        && request.resource.data.creatorId == request.auth.uid
        && (request.resource.data.visibility != "official" || isAdmin());

      // Creator can update their own packs, admins can update any.
      // Only admins can set visibility to "official".
      allow update: if (isAuthenticated() && resource.data.creatorId == request.auth.uid || isAdmin())
        && (request.resource.data.visibility != "official" || isAdmin());

      // Creator can delete their own packs, admins can delete any
      allow delete: if (isAuthenticated() && resource.data.creatorId == request.auth.uid) || isAdmin();
    }

    // ─────────────────────────────────────────────────────────────
    // FYVE KEYS (Server-only secret key assignments)
    // ─────────────────────────────────────────────────────────────

    match /fyveKeys/{keyId} {
      // Keys are NEVER readable by clients — only via Admin SDK in API routes
      allow read, create, update, delete: if false;
    }

    // ─────────────────────────────────────────────────────────────
    // BOATY BOARDS (Server-only secret board placements)
    // ─────────────────────────────────────────────────────────────

    match /boatyBoards/{sessionId}/boards/{uid} {
      // Hidden raft/gator placements, one doc per player. A player may read their
      // OWN board (so it survives a reconnect); the opponent's is NEVER readable.
      // Writes are Admin-SDK-only (Boaty API route on setup + gameEngine on gator
      // slither), so a board can't be forged or peeked.
      allow read: if isAuthenticated() && request.auth.uid == uid;
      allow write: if false;
    }

    // Blarf — per-player secret role for the current round. A player may read
    // their OWN role (word / Blarfer status); others' are NEVER readable, so the
    // Blarfer list can't be peeked before the reveal. Admin-SDK writes only.
    match /blarfRoles/{sessionId}/roles/{uid} {
      allow read: if isAuthenticated() && request.auth.uid == uid;
      allow write: if false;
    }

    // Blarf — the pack's per-round data (letters + word pools), server-only.
    // Never client-readable; written by the Blarf API route, read by gameEngine.
    match /blarfSecret/{sessionId} {
      allow read, write: if false;
    }

    // BluffBox — the card pool + the current sharer's hidden truth/lie answer,
    // server-only so guessers can't peek the answer before the reveal. Written
    // by the BluffBox API route + gameEngine; never client-readable.
    match /bluffSecrets/{sessionId} {
      allow read, write: if false;
    }

    // Lineup — per-player secret fun fact. A player may read their OWN fact (so
    // their client knows when the on-screen fact is theirs and sits out the
    // round); others' are NEVER readable, so authorship can't be peeked before
    // the reveal. Admin-SDK writes only (the Lineup API route + gameEngine).
    match /lineupFacts/{sessionId}/facts/{uid} {
      allow read: if isAuthenticated() && request.auth.uid == uid;
      allow write: if false;
    }

    // Lineup — the shuffled fact order (index → author), server-only so the
    // mapping can't leak before the reveal. Written by gameEngine; never
    // client-readable.
    match /lineupSecret/{sessionId} {
      allow read, write: if false;
    }

    // Legacy sevyn collections — read-only for migration (remove after migration)
    match /sevynHeists/{heistId} {
      allow read: if true;
    }
    match /sevynBombs/{bombId} {
      allow read: if true;
    }

    // ─────────────────────────────────────────────────────────────
    // CLEANUP LOGS (Data cleanup audit trail)
    // ─────────────────────────────────────────────────────────────
    
    match /cleanupLogs/{logId} {
      allow read: if isAdmin();
      allow create, update, delete: if false; // Only via Admin SDK
    }
    
    // ─────────────────────────────────────────────────────────────
    // SIGNUP FUNNEL COLLECTION (Analytics tracking)
    // ─────────────────────────────────────────────────────────────
    
    match /signup_funnel/{funnelId} {
      // Anyone can create a funnel entry (tracks page visits)
      allow create: if true;

      // Anyone can update their funnel entry (tracks signup attempts/completion)
      allow update: if true;

      // Only admins can read or delete funnel data
      allow read, delete: if isAdmin();
    }

    // ─────────────────────────────────────────────────────────────
    // TRIVIA RESEARCH COLLECTIONS (Inventing.Studio → AI Agents)
    // All writes go through the Admin SDK in /api/admin/trivia-research,
    // so client writes are denied. Admin clients can read for the
    // dashboard, tags panel, and content browser.
    // ─────────────────────────────────────────────────────────────

    match /trivia-content/{subjectId} {
      allow read: if isAdmin();
      allow create, update, delete: if false; // Admin SDK only
    }

    match /trivia-tags/{tagId} {
      allow read: if isAdmin();
      allow create, update, delete: if false; // Admin SDK only
    }

    match /trivia-agent-state/{stateKey} {
      allow read: if isAdmin();
      allow create, update, delete: if false; // Admin SDK only
    }

    match /trivia-source-cache/{cacheKey} {
      allow read: if isAdmin();
      allow create, update, delete: if false; // Admin SDK only
    }

    // ─────────────────────────────────────────────────────────────
    // SCROLLYFOX DOCUMENTS (admin-authored scroll experiences)
    // Authored client-side in the admin-gated /scrollyfox editor.
    // Read stays admin-only until a public reader + publish flag land.
    // ─────────────────────────────────────────────────────────────

    match /scrollyfoxes/{scrollyFoxId} {
      allow read: if isAdmin();
      allow create, update, delete: if isAdmin();
    }
  }
}
