rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    
    // ─────────────────────────────────────────────────────────────
    // HELPER FUNCTIONS
    // ─────────────────────────────────────────────────────────────
    
    // Check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Check if user is admin
    function isAdmin() {
      return isAuthenticated() && request.auth.token.admin == true;
    }
    
    // Validate image file type
    function isImage() {
      return request.resource.contentType.matches('image/.*');
    }
    
    // Validate video file type
    function isVideo() {
      return request.resource.contentType.matches('video/.*');
    }
    
    // Validate audio file type
    function isAudio() {
      return request.resource.contentType.matches('audio/.*');
    }
    
    // Validate JSON file type (for Lottie avatars)
    function isJSON() {
      return request.resource.contentType == 'application/json';
    }
    
    // Max file size validation (in bytes)
    function maxSize(sizeInMB) {
      return request.resource.size < sizeInMB * 1024 * 1024;
    }
    
    // ─────────────────────────────────────────────────────────────
    // CONTENT IMAGES (covers, backdrops)
    // ─────────────────────────────────────────────────────────────
    
    match /content-images/{contentId}/{fileName} {
      // Anyone can read content images (they're public)
      allow read: if true;
      
      // Only admins can upload content images
      // Must be an image under 10MB
      allow write: if isAdmin() && isImage() && maxSize(10);
      
      // Only admins can delete
      allow delete: if isAdmin();
    }
    
    // ─────────────────────────────────────────────────────────────
    // BRAND LOGOS
    // ─────────────────────────────────────────────────────────────
    
    match /brand-logos/{brandId}/{fileName} {
      // Anyone can read brand logos (they're public)
      allow read: if true;
      
      // Only admins can upload brand logos
      // Must be an image under 5MB
      allow write: if isAdmin() && isImage() && maxSize(5);
      
      // Only admins can delete
      allow delete: if isAdmin();
    }
    
    // ─────────────────────────────────────────────────────────────
    // USER AVATARS (Lottie JSON files)
    // ─────────────────────────────────────────────────────────────
    
    match /avatars/{category}/{fileName} {
      // Anyone can read avatars (they're public assets)
      allow read: if true;
      
      // Only admins can upload avatars
      // Must be JSON under 1MB
      allow write: if isAdmin() && isJSON() && maxSize(1);
      
      // Only admins can delete
      allow delete: if isAdmin();
    }
    
    // ─────────────────────────────────────────────────────────────
    // AI ARTIST AVATARS
    // ─────────────────────────────────────────────────────────────
    
    match /artist-avatars/{artistId}/{fileName} {
      // Anyone can read artist avatars (they're public)
      allow read: if true;
      
      // Only admins can upload artist avatars
      // Must be an image under 5MB
      allow write: if isAdmin() && isImage() && maxSize(5);
      
      // Only admins can delete
      allow delete: if isAdmin();
    }
    
    // ─────────────────────────────────────────────────────────────
    // AI ARTIST COVERS (for home rows - 2:1 wide)
    // ─────────────────────────────────────────────────────────────
    
    match /artist-covers/{artistId}/{fileName} {
      // Anyone can read artist covers (they're public)
      allow read: if true;
      
      // Only admins can upload artist covers
      // Must be an image under 5MB
      allow write: if isAdmin() && isImage() && maxSize(5);
      
      // Only admins can delete
      allow delete: if isAdmin();
    }
    
    // ─────────────────────────────────────────────────────────────
    // AI ARTIST BANNERS (for featured carousel - 16:9)
    // ─────────────────────────────────────────────────────────────
    
    match /artist-banners/{artistId}/{fileName} {
      // Anyone can read artist banners (they're public)
      allow read: if true;
      
      // Only admins can upload artist banners
      // Must be an image under 10MB
      allow write: if isAdmin() && isImage() && maxSize(10);
      
      // Only admins can delete
      allow delete: if isAdmin();
    }
    
    // ─────────────────────────────────────────────────────────────
    // ARTIST LOGIN BACKGROUNDS (custom auth page backgrounds)
    // ─────────────────────────────────────────────────────────────
    
    match /artist-login-bgs/{artistId}/{fileName} {
      // Anyone can read login backgrounds (needed for auth page)
      allow read: if true;
      
      // Only admins can upload login backgrounds
      // Must be an image under 10MB
      allow write: if isAdmin() && isImage() && maxSize(10);
      
      // Only admins can delete
      allow delete: if isAdmin();
    }
    
    // ─────────────────────────────────────────────────────────────
    // ALBUM COVERS (images and short videos)
    // ─────────────────────────────────────────────────────────────
    
    match /album-covers/{albumId}/{fileName} {
      // Anyone can read album covers (they're public)
      allow read: if true;
      
      // Only admins can upload album covers
      // Images: under 5MB, Videos: under 15MB (for short looping covers)
      allow write: if isAdmin() && (
        (isImage() && maxSize(5)) ||
        (isVideo() && maxSize(15))
      );
      
      // Only admins can delete
      allow delete: if isAdmin();
    }
    
    // ─────────────────────────────────────────────────────────────
    // SONG AUDIO FILES
    // ─────────────────────────────────────────────────────────────
    
    match /songs/{songId}/{fileName} {
      // Anyone can read song audio (they're public)
      allow read: if true;
      
      // Only admins can upload song audio
      // Must be audio under 50MB
      allow write: if isAdmin() && isAudio() && maxSize(50);
      
      // Only admins can delete
      allow delete: if isAdmin();
    }
    
    // ─────────────────────────────────────────────────────────────
    // GAME BACKGROUND MUSIC
    // ─────────────────────────────────────────────────────────────
    
    match /content-audio/{contentId}/{fileName} {
      allow read: if true;
      allow write: if isAdmin() && isAudio() && maxSize(30);
      allow delete: if isAdmin();
    }
    
    // ─────────────────────────────────────────────────────────────
    // MUSIC VIDEO THUMBNAILS
    // ─────────────────────────────────────────────────────────────
    
    match /music-video-thumbnails/{videoId}/{fileName} {
      // Anyone can read thumbnails (they're public)
      allow read: if true;
      
      // Only admins can upload thumbnails
      // Must be an image under 5MB
      allow write: if isAdmin() && isImage() && maxSize(5);
      
      // Only admins can delete
      allow delete: if isAdmin();
    }
    
    // ─────────────────────────────────────────────────────────────
    // AUCTION IMAGES (thumbnails and detail images)
    // ─────────────────────────────────────────────────────────────
    
    match /auction-images/{itemId}/{fileName} {
      // Anyone can read auction images (public)
      allow read: if true;
      
      // Only admins can upload auction images
      // Must be an image under 10MB
      allow write: if isAdmin() && isImage() && maxSize(10);
      
      // Only admins can delete
      allow delete: if isAdmin();
    }
    
    // ─────────────────────────────────────────────────────────────
    // STORY COVERS
    // ─────────────────────────────────────────────────────────────
    
    match /story-covers/{storyId}/{fileName} {
      // Anyone can read story covers (they're public)
      allow read: if true;
      
      // Only admins can upload story covers
      // Must be an image under 10MB
      allow write: if isAdmin() && isImage() && maxSize(10);
      
      // Only admins can delete
      allow delete: if isAdmin();
    }
    
    // ─────────────────────────────────────────────────────────────
    // STORY COVER THUMBNAILS (1:2 portrait, for scroller rows)
    // ─────────────────────────────────────────────────────────────
    
    match /story-thumbnails/{storyId}/{fileName} {
      allow read: if true;
      allow write: if isAdmin() && isImage() && maxSize(5);
      allow delete: if isAdmin();
    }
    
    // ─────────────────────────────────────────────────────────────
    // STORY EPUB FILES
    // ─────────────────────────────────────────────────────────────
    
    match /story-epubs/{storyId}/{fileName} {
      allow read: if true;
      allow write: if isAdmin() && request.resource.size < 50 * 1024 * 1024;
      allow delete: if isAdmin();
    }
    
    // ─────────────────────────────────────────────────────────────
    // FEATURED IMAGES (if separate from content images)
    // ─────────────────────────────────────────────────────────────
    
    match /featured-images/{featuredId}/{fileName} {
      // Anyone can read featured images (they're public)
      allow read: if true;
      
      // Only admins can upload featured images
      // Must be an image under 10MB
      allow write: if isAdmin() && isImage() && maxSize(10);
      
      // Only admins can delete
      allow delete: if isAdmin();
    }

    // ─────────────────────────────────────────────────────────────
    // LEVEL ICONS (gamification badges - realistic & isometric)
    // ─────────────────────────────────────────────────────────────
    
    match /level-icons/{levelId}/{fileName} {
      allow read: if true;
      allow write: if isAdmin() && isImage() && maxSize(5);
      allow delete: if isAdmin();
    }
    
    // ─────────────────────────────────────────────────────────────
    // FEATURED BACKDROP IMAGES
    // ─────────────────────────────────────────────────────────────

    match /featured-backdrops/{featuredId}/{fileName} {
      allow read: if true;
      allow write: if isAdmin() && isImage() && maxSize(10);
      allow delete: if isAdmin();
    }
    
    // ─────────────────────────────────────────────────────────────
    // BLUFF BOX PACKS (Pack covers and card images)
    // ─────────────────────────────────────────────────────────────
    
    match /bluffbox-packs/{packId}/{allPaths=**} {
      allow read: if true;
      allow write: if isAuthenticated() && isImage() && maxSize(5);
      allow delete: if isAdmin();
    }
    
    // ─────────────────────────────────────────────────────────────
    // FYVE HEISTS (Heist images + per-element bomb sound effects)
    // ─────────────────────────────────────────────────────────────

    match /fyve-heists/{heistId}/{allPaths=**} {
      allow read: if true;
      allow write: if isAuthenticated() && (isImage() || isAudio()) && maxSize(5);
      allow delete: if isAdmin();
    }

    // Legacy sevyn-heists path — read-only for existing asset URLs (remove after full migration)
    match /sevyn-heists/{heistId}/{allPaths=**} {
      allow read: if true;
    }

    // ─────────────────────────────────────────────────────────────
    // FYVE BOMBS (Bomb images and audio)
    // ─────────────────────────────────────────────────────────────

    match /fyve-bombs/{bombId}/{allPaths=**} {
      allow read: if true;
      allow write: if isAuthenticated() && (isImage() || isAudio()) && maxSize(5);
      allow delete: if isAdmin();
    }

    // Legacy sevyn-bombs path — read-only for existing asset URLs (remove after full migration)
    match /sevyn-bombs/{bombId}/{allPaths=**} {
      allow read: if true;
    }

    // ─────────────────────────────────────────────────────────────
    // GAME SKETCHES (Sketchiness drawing uploads)
    // ─────────────────────────────────────────────────────────────
    
    match /game-sketches/{sessionId}/{round}/{fileName} {
      // Anyone can read game sketches (needed for gameplay)
      allow read: if true;
      
      // Authenticated users can upload sketches during gameplay
      // Must be an image under 2MB
      allow write: if isAuthenticated() && isImage() && maxSize(2);
      
      // Admins can clean up
      allow delete: if isAdmin();
    }
  }
}
